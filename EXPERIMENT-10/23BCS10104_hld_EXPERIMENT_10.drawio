        <mxCell id="e6cEapLkofOJf_R8qBUq-36" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;backgroundOutline=0;shadow=0;" value="Redis Pub/Sub distributes to all active subscribers" vertex="1">
