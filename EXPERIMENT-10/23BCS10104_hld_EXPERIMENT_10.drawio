        </mxCell>
        <mxCell id="e6cEapLkofOJf_R8qBUq-37" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;Reliability&lt;/b&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Kafka and RabbitMQ flows should ensure message delivery even after consumer downtime.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Redis behavior should demonstrate non-reliability intentionally.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="760" x="690.85" y="980" as="geometry" />
        </mxCell>
        <mxCell id="e6cEapLkofOJf_R8qBUq-39" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;Performance&lt;/b&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Message processing should happen with minimal delay (low latency).&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;System should handle multiple messages without noticeable lag.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="650" x="670" y="930" as="geometry" />
        </mxCell>
        <mxCell id="e6cEapLkofOJf_R8qBUq-40" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;Fault Simulation Capability&lt;/b&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;System should support toggling consumers ON/OFF to simulate failures.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="350" x="770" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="e6cEapLkofOJf_R8qBUq-43" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;Fault Simulation Capability&lt;/b&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;System should support toggling consumers ON/OFF to simulate failures.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="280" x="770" y="1190" as="geometry" />
        </mxCell>
        <mxCell id="e6cEapLkofOJf_R8qBUq-45" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Message Submission&lt;/font&gt;&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;The system should allow users to send a message through the UI.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;User must select a broker:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Kafka&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;RabbitMQ&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Redis&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="550" x="1560" y="930" as="geometry" />
        </mxCell>
        <mxCell id="e6cEapLkofOJf_R8qBUq-46" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Broker-based Routing&lt;/font&gt;&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;The backend should route the message to the selected messaging system.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Each broker should have its own producer logic.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="390" x="1560" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="e6cEapLkofOJf_R8qBUq-48" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Consumer Control&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Users should be able to enable/disable consumers.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
